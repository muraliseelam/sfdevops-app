<mxfile host="drawio" agent="sfdevops-docs" version="24.0.0">
  <diagram id="architecture" name="architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="&lt;b&gt;Developers, release managers, auditors&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="20" width="320" height="50" as="geometry"/></mxCell>
        <mxCell id="c3" value="Salesforce hub org: system of record + UI&lt;br&gt;(app SF DevOps, branch platform/sfdevops-app)" style="swimlane;whiteSpace=wrap;html=1;startSize=30;rounded=1;fillColor=#eef4fb;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="560" height="430" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;UI&lt;/b&gt;: app SF_DevOps, 13 LWCs, 17 tabs, 6 pages&lt;br&gt;work item command center, pipeline, release board, governance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Apex services&lt;/b&gt;: GitHubService, CDO_WorkItemService,&lt;br&gt;CDOPromotionDispatcher (the queue), CDO_CallbackService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;22 CDO objects&lt;/b&gt;: projects, stages, environments, work items, commits,&lt;br&gt;components, promotions + junction, deployments, releases, approvals, audit events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Named Credential GitHub_API&lt;/b&gt;&lt;br&gt;token in External Credential GitHub_API_Credential" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="250" height="70" as="geometry"/></mxCell>

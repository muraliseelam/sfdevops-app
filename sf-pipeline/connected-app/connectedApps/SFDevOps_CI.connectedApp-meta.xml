<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Reference Connected App for the pipeline's JWT sign-in (see ../README.md).
         Many orgs now refuse NEW Connected Apps; use an External Client App or the SFDX auth URL
         mode there. Comments stay inside the root element: a comment before it breaks sfdx
         source parsing. Replace contactEmail before deploying. -->
    <contactEmail>admin@example.com</contactEmail>
    <description>SF DevOps CI: JWT bearer sign-in for the GitHub Actions pipeline. Admin-approved users only.</description>
    <label>SF DevOps CI</label>
    <oauthConfig>
        <callbackUrl>http://localhost:1717/OauthRedirect</callbackUrl>
        <!-- CERTIFICATE PLACEHOLDER: before deploying, add the public certificate (server.crt, PEM,
             including the BEGIN/END lines) here as
             <certificate>-----BEGIN CERTIFICATE-----
             ...
             -----END CERTIFICATE-----</certificate>
             Never put the private key (server.key) in this file or anywhere in the repository. -->
        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
        <scopes>Web</scopes>
    </oauthConfig>
    <oauthPolicy>
        <ipRelaxation>BYPASS</ipRelaxation>
        <refreshTokenPolicy>infinite</refreshTokenPolicy>
    </oauthPolicy>
    <profileName>System Administrator</profileName>
</ConnectedApp>

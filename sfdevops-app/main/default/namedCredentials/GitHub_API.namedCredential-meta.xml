<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- callout:GitHub_API. Sends Authorization: Bearer <Token> from the External Credential
         GitHub_API_Credential (principal GitHub_PAT). No token value lives in metadata. -->
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>true</allowMergeFieldsInHeader>
    <calloutStatus>Enabled</calloutStatus>
    <description>GitHub REST API (https://api.github.com) for workflow_dispatch and repository calls from GitHubService.</description>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <label>GitHub API</label>
    <namedCredentialParameters>
        <parameterName>Url</parameterName>
        <parameterType>Url</parameterType>
        <parameterValue>https://api.github.com</parameterValue>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <externalCredential>GitHub_API_Credential</externalCredential>
        <parameterName>ExternalCredential</parameterName>
        <parameterType>Authentication</parameterType>
    </namedCredentialParameters>
    <namedCredentialParameters>
        <parameterName>Authorization</parameterName>
        <parameterType>HttpHeader</parameterType>
        <parameterValue>{!&apos;Bearer &apos; &amp; $Credential.GitHub_API_Credential.Token}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </namedCredentialParameters>
    <namedCredentialType>SecuredEndpoint</namedCredentialType>
</NamedCredential>
